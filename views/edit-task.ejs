
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Task</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <h1>Edit Task</h1>

    <form action="/tasks/<%= task.id %>?_method=PUT"  method="POST">
      <label>Title</label>
      <input type="text" name="title"  value="<%= task.title %>" required>
    <br><br>
      <label>Description</label>
      <textarea name="description"><%= task.description %></textarea>
    <br><br>
      <label>Priority</label>
      <select name="priority">
        <% ["Low", "Medium", "High"].forEach(priority => { %>
          <option value="<%= priority %>"   <%= task.priority === priority ? "selected" : "" %> >
            <%= priority %>
          </option>
        <% }) %>
      </select>
      <br><br>
      <label>Status</label>
      <select name="status">
        <% ["To Do", "In Progress", "Done"].forEach(status => { %>
          <option value="<%= status %>"    <%= task.status === status ? "selected" : "" %> >
            <%= status %>
          </option>
        <% }) %>
      </select>
      <br><br>
      <label>Assign User</label>
      <select name="assignedTo">
        <% users.forEach(user => { %>
          <option value="<%= user.id %>"  <%= task.assignedTo === user.id ? "selected" : "" %> >
            <%= user.username %>
          </option>
        <% }) %>
      </select>
      <br><br>
      <h3>Task Dependencies</h3>
      <p>Select any tasks that must be completed first.</p>
      <br>
      <% tasks.forEach(otherTask => { %>
        <label class="checkbox-label">
          <input
            type="checkbox"
            name="dependencies"
            value="<%= otherTask.id %>"
            <%= task.dependencies.includes(otherTask.id) ? "checked" : "" %>
          >
          <%= otherTask.title %> — <%= otherTask.status %>
        </label>
      <% }) %>
        <br><br>
      <button type="submit">Save Changes</button>
    </form>
    <br><br>
    <a href="/tasks">Cancel Changes</a>
  </main>
</body>
</html>
